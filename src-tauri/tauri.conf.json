{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lueur",
  "version": "0.3.1",
  "identifier": "app.lueur.writer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lueur",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#ECE8E2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Écrire à la lueur de la lampe.",
    "copyright": "© 2026 Lueur",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 340
        },
        "appPosition": {
          "x": 150,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 160
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBM0U0MDc4NDBEM0VFQzcKUldUSDd0TkFlRUErT3B4cjc1QjFOd3dVSjFNSUh1N3NGYWFoUWNHeGtGejZtS2NjVStUQWI4Y0sK",
      "endpoints": [
        "https://github.com/ByteOneDev/Lueur/releases/latest/download/latest.json"
      ]
    }
  }
}
